{
  "SDKVersion": 2,
  "Author": "Xavi Parrec",
  "CodePath": "bin/plugin.cjs",
  "Description": "Windows volume, media, application and power controls for OpenDeck.",
  "Name": "Windows Essentials",
  "Icon": "imgs/plugin-icon",
  "URL": "https://github.com/xaviparrec/windows-essentials-opendeck",
  "Version": "0.15.1",
  "Software": { "MinimumVersion": "6.5" },
  "Nodejs": { "Version": "20" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Category": "Windows Essentials",
  "CategoryIcon": "imgs/plugin-icon",
  "Actions": [{
    "Icon": "imgs/output-icon",
    "Name": "Master Volume",
    "Controllers": ["Encoder"],
    "Encoder": {
      "layout": "$B1",
      "Icon": "imgs/volume-icon",
      "TriggerDescription": {
        "Rotate": "Increase or decrease the master volume",
        "Push": "Mute or unmute the master volume"
      }
    },
    "Tooltip": "Rotate to adjust volume; press to mute or unmute.",
    "States": [{ "Image": "imgs/volume-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.master-volume"
  }, {
    "Icon": "imgs/microphone-icon",
    "Name": "Microphone Volume",
    "Controllers": ["Encoder"],
    "Encoder": {
      "layout": "$B1",
      "Icon": "imgs/microphone-icon",
      "TriggerDescription": {
        "Rotate": "Increase or decrease the microphone volume",
        "Push": "Mute or unmute the microphone"
      }
    },
    "Tooltip": "Rotate to adjust the microphone; press to mute or unmute.",
    "States": [{ "Image": "imgs/microphone-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.microphone-volume"
  }, {
    "Icon": "imgs/volume-icon",
    "Name": "Audio Output",
    "Controllers": ["Keypad"],
    "PropertyInspectorPath": "propertyInspector/audio-output.html",
    "DisableAutomaticStates": true,
    "Tooltip": "Switch between two configured audio outputs.",
    "States": [
      { "Image": "imgs/output-icon" },
      { "Image": "imgs/headphones-icon" }
    ],
    "UUID": "net.parrec.deck.windows-essentials.audio-output"
  }, {
    "Icon": "imgs/volume-icon",
    "Name": "Audio Output Selector",
    "Controllers": ["Encoder"],
    "PropertyInspectorPath": "propertyInspector/audio-output-selector.html",
    "Encoder": {
      "layout": "$A1",
      "Icon": "imgs/volume-icon",
      "TriggerDescription": {
        "Rotate": "Select the next or previous active audio output",
        "Push": "Make the displayed output the Windows default"
      }
    },
    "Tooltip": "Rotate through active Windows audio outputs; press to select one.",
    "States": [{ "Image": "imgs/volume-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.audio-output-selector"
  }, {
    "Icon": "imgs/volume-icon",
    "Name": "App Volume",
    "Controllers": ["Encoder"],
    "PropertyInspectorPath": "propertyInspector/app-volume.html",
    "Encoder": {
      "layout": "$B1",
      "Icon": "imgs/volume-icon",
      "TriggerDescription": {
        "Rotate": "Adjust the selected application's volume",
        "Push": "Mute or unmute the selected application"
      }
    },
    "Tooltip": "Control volume for one active Windows application.",
    "States": [{ "Image": "imgs/volume-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.app-volume"
  }, {
    "Icon": "imgs/media-toggle-icon",
    "Name": "Media: Play / Pause",
    "Controllers": ["Keypad"],
    "DisableAutomaticStates": true,
    "Tooltip": "Play or pause the current media.",
    "States": [
      { "Image": "imgs/play-pause-icon" },
      { "Image": "imgs/pause-icon" }
    ],
    "UUID": "net.parrec.deck.windows-essentials.media-play-pause"
  }, {
    "Icon": "imgs/previous-icon",
    "Name": "Media: Previous",
    "Controllers": ["Keypad"],
    "Tooltip": "Skip to the previous track or item.",
    "States": [{ "Image": "imgs/previous-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.media-previous"
  }, {
    "Icon": "imgs/next-icon",
    "Name": "Media: Next",
    "Controllers": ["Keypad"],
    "Tooltip": "Skip to the next track or item.",
    "States": [{ "Image": "imgs/next-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.media-next"
  }, {
    "Icon": "imgs/lock-icon",
    "Name": "Power Action",
    "Controllers": ["Keypad"],
    "PropertyInspectorPath": "propertyInspector/power-action.html",
    "Tooltip": "Lock, sleep, restart or shut down Windows.",
    "States": [
      { "Image": "imgs/lock-icon" },
      { "Image": "imgs/sleep-icon" },
      { "Image": "imgs/restart-icon" },
      { "Image": "imgs/shutdown-icon" },
      { "Image": "imgs/restart-confirm-icon" },
      { "Image": "imgs/shutdown-confirm-icon" }
    ],
    "UUID": "net.parrec.deck.windows-essentials.power-action"
  }]
}
