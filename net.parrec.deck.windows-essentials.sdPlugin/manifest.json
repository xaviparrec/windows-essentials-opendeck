{
  "SDKVersion": 2,
  "Author": "Xavi",
  "CodePath": "bin/plugin.cjs",
  "Description": "Controla el volum master de Windows amb un encoder.",
  "Name": "Windows Essentials",
  "Icon": "imgs/plugin-icon",
  "URL": "https://github.com/",
  "Version": "0.7.1",
  "Software": { "MinimumVersion": "6.5" },
  "Nodejs": { "Version": "20" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Category": "Windows Essentials",
  "CategoryIcon": "imgs/plugin-icon",
  "Actions": [{
    "Icon": "imgs/volume-icon",
    "Name": "Master Volume",
    "Controllers": ["Encoder"],
    "Encoder": {
      "layout": "$B1",
      "Icon": "imgs/volume-icon",
      "TriggerDescription": {
        "Rotate": "Puja o baixa el volum master",
        "Push": "Activa o desactiva el silenci"
      }
    },
    "Tooltip": "Gira per ajustar el volum; prem per silenciar.",
    "States": [{ "Image": "imgs/volume-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.master-volume"
  }, {
    "Icon": "imgs/media-toggle-icon",
    "Name": "Media: Play / Pause",
    "Controllers": ["Keypad"],
    "DisableAutomaticStates": true,
    "Tooltip": "Reprodueix o pausa el contingut multimèdia.",
    "States": [
      { "Image": "imgs/play-pause-icon" },
      { "Image": "imgs/pause-icon" }
    ],
    "UUID": "net.parrec.deck.windows-essentials.media-play-pause"
  }, {
    "Icon": "imgs/previous-icon",
    "Name": "Media: Previous",
    "Controllers": ["Keypad"],
    "Tooltip": "Pista o element anterior.",
    "States": [{ "Image": "imgs/previous-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.media-previous"
  }, {
    "Icon": "imgs/next-icon",
    "Name": "Media: Next",
    "Controllers": ["Keypad"],
    "Tooltip": "Pista o element següent.",
    "States": [{ "Image": "imgs/next-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.media-next"
  }, {
    "Icon": "imgs/lock-icon",
    "Name": "Lock PC",
    "Controllers": ["Keypad"],
    "Tooltip": "Bloqueja la sessió de Windows.",
    "States": [{ "Image": "imgs/lock-icon" }],
    "UUID": "net.parrec.deck.windows-essentials.lock-pc"
  }]
}
